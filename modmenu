local function XGDBFN_fake_script() -- ViewButton_3.LocalScript 
	local script = Instance.new('LocalScript', ViewButton_3)

	
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	
	local player = Players.LocalPlayer
	local button = script.Parent
	
	local espEnabled = false
	local espObjects = {}
	local updateConnection
	
	button.Text = "ESP: Off"
	
	local function removeESP(target)
		local data = espObjects[target]
	
		if data then
			if data.Highlight then
				data.Highlight:Destroy()
			end
	
			if data.Billboard then
				data.Billboard:Destroy()
			end
	
			espObjects[target] = nil
		end
	end
	
	local function createESP(target)
		if target == player then return end
		if not target.Character then return end
	
		removeESP(target)
	
		local character = target.Character
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		local head = character:FindFirstChild("Head")
	
		if not humanoid or not head then return end
	
		-- White highlight
		local highlight = Instance.new("Highlight")
		highlight.Name = "PlayerESPHighlight"
		highlight.Adornee = character
		highlight.FillColor = Color3.fromRGB(255, 255, 255)
		highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		highlight.FillTransparency = 0.8
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Parent = character
	
		-- Player information above head
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "PlayerESPInfo"
		billboard.Adornee = head
		billboard.Size = UDim2.fromOffset(250, 60)
		billboard.StudsOffset = Vector3.new(0, 3, 0)
		billboard.AlwaysOnTop = true
		billboard.Parent = player:WaitForChild("PlayerGui")
	
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.TextStrokeTransparency = 0
		label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
		label.Font = Enum.Font.GothamBold
		label.TextSize = 14
		label.Text = target.Name
		label.Parent = billboard
	
		espObjects[target] = {
			Highlight = highlight,
			Billboard = billboard,
			Label = label,
		}
	end
	
	local function refreshESP()
		for target in pairs(espObjects) do
			removeESP(target)
		end
	
		if not espEnabled then return end
	
		for _, target in ipairs(Players:GetPlayers()) do
			createESP(target)
		end
	end
	
	local function updateESP()
		local myCharacter = player.Character
		local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")
	
		if not myRoot then return end
	
		for target, data in pairs(espObjects) do
			local character = target.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
	
			if humanoid and root and data.Label then
				local distance = (myRoot.Position - root.Position).Magnitude
				local health = math.floor(humanoid.Health)
	
				data.Label.Text = string.format(
					"%s | Health: %d | Distance: %d",
					target.Name,
					health,
					distance
				)
			end
		end
	end
	
	button.MouseButton1Click:Connect(function()
		espEnabled = not espEnabled
	
		button.Text = "ESP: " .. (espEnabled and "On" or "Off")
	
		if espEnabled then
			refreshESP()
	
			updateConnection = RunService.RenderStepped:Connect(updateESP)
		else
			if updateConnection then
				updateConnection:Disconnect()
				updateConnection = nil
			end
	
			refreshESP()
		end
	end)
	
	Players.PlayerAdded:Connect(function(target)
		target.CharacterAdded:Connect(function()
			task.wait(1)
	
			if espEnabled then
				createESP(target)
			end
		end)
	end)
	
	Players.PlayerRemoving:Connect(function(target)
		removeESP(target)
	end)
	
end
coroutine.wrap(XGDBFN_fake_script)()

fovBox.FocusLost:Connect(function()
	local parsed = tonumber(fovBox.Text)
	if parsed then
		FOV_RADIUS = math.clamp(parsed, 10, 1000)
	end
	updateFovRadiusDisplay()
end)

smoothBox.FocusLost:Connect(function()
	local parsed = tonumber(smoothBox.Text)
	if parsed then
		SMOOTHNESS = math.clamp(parsed, 0.01, 1)
	end
	updateSmoothDisplay()
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == Enum.KeyCode.E then
		AIMBOT_ENABLED = not AIMBOT_ENABLED
		updateAimbotState()
	end
end)

minus.MouseButton1Click:Connect(function()
	SMOOTHNESS = math.clamp(SMOOTHNESS - 0.05, 0.01, 1)
	updateSmoothDisplay()
end)

plus.MouseButton1Click:Connect(function()
	SMOOTHNESS = math.clamp(SMOOTHNESS + 0.05, 0.01, 1)
	updateSmoothDisplay()
end)


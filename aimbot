local function updateAimbotState()
	if AIMBOT_ENABLED then
		toggleButton.Text = "Aimbot: ON"
		fovCircle.Visible = true
	else
		toggleButton.Text = "Aimbot: OFF"
		fovCircle.Visible = false
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		MOUSE_LOCKED = false
	end
end

local function updateTeamCheckState()
	teamButton.Text = TEAM_CHECK_ENABLED and "Team Check: ON" or "Team Check: OFF"
end

local function updateWallCheckState()
	wallButton.Text = WALL_CHECK_ENABLED and "Wall Check: ON" or "Wall Check: OFF"
end

local function updateSmoothDisplay()
	smoothBox.Text = string.format("%.2f", SMOOTHNESS)
end

toggleButton.MouseButton1Click:Connect(function()
	AIMBOT_ENABLED = not AIMBOT_ENABLED
	updateAimbotState()
end)

teamButton.MouseButton1Click:Connect(function()
	TEAM_CHECK_ENABLED = not TEAM_CHECK_ENABLED
	updateTeamCheckState()
end)

wallButton.MouseButton1Click:Connect(function()
	WALL_CHECK_ENABLED = not WALL_CHECK_ENABLED
	updateWallCheckState()
end)

smoothBox.FocusLost:Connect(function()
	local parsed = tonumber(smoothBox.Text)
	if parsed then
		SMOOTHNESS = math.clamp(parsed, 0.01, 1)
	end
	updateSmoothDisplay()
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	
	if input.KeyCode == Enum.KeyCode.E then
		AIMBOT_ENABLED = not AIMBOT_ENABLED
		updateAimbotState()
	end
end)

minus.MouseButton1Click:Connect(function()
	SMOOTHNESS = math.clamp(SMOOTHNESS - 0.05, 0.01, 1)
	updateSmoothDisplay()
end)

plus.MouseButton1Click:Connect(function()
	SMOOTHNESS = math.clamp(SMOOTHNESS + 0.05, 0.01, 1)
	updateSmoothDisplay()
end)


end)

toggleButton.MouseButton1Click:Connect(function()
	AIMBOT_ENABLED = not AIMBOT_ENABLED
	updateAimbotState()
end)

teamButton.MouseButton1Click:Connect(function()
	TEAM_CHECK_ENABLED = not TEAM_CHECK_ENABLED

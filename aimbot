-- State update functions
local function updateAimbotState()
	toggleButton.Text = AIMBOT_ENABLED and "Aimbot: ON" or "Aimbot: OFF"
	toggleButton.BackgroundColor3 = AIMBOT_ENABLED and ON_COLOR or OFF_COLOR
	if not AIMBOT_ENABLED then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		MOUSE_LOCKED = false
	end
end

local function updateTeamCheckState()
	teamButton.Text = TEAM_CHECK_ENABLED and "Team Check: ON" or "Team Check: OFF"
	teamButton.BackgroundColor3 = TEAM_CHECK_ENABLED and ON_COLOR or OFF_COLOR
end

local function updateWallCheckState()
	wallButton.Text = WALL_CHECK_ENABLED and "Wall Check: ON" or "Wall Check: OFF"
	wallButton.BackgroundColor3 = WALL_CHECK_ENABLED and ON_COLOR or OFF_COLOR
end

local function updateFovCircleState()
	fovCircle.Visible = SHOW_FOV_CIRCLE
	fovButton.Text = SHOW_FOV_CIRCLE and "Show FOV Circle: ON" or "Show FOV Circle: OFF"
	fovButton.BackgroundColor3 = SHOW_FOV_CIRCLE and ON_COLOR or OFF_COLOR
end

local function updateSmoothDisplay()
	smoothBox.Text = string.format("%.2f", SMOOTHNESS)
end


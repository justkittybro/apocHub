local function GJHXG_fake_script() -- PlayerButton_3.LocalScript 
	local script = Instance.new('LocalScript', PlayerButton_3)

	
	local Players = game:GetService("Players")
	
	local player = Players.LocalPlayer
	local button = script.Parent
	
	button.Activated:Connect(function()
		local city = workspace:FindFirstChild("City")
		if not city then return end
	
		local store = city:FindFirstChild("Store")
		if not store then return end
	
		local npc = store:FindFirstChild("NPC")
		if not npc then return end
	
		local npcRoot = npc:FindFirstChild("HumanoidRootPart")
			or npc.PrimaryPart
	
		if not npcRoot then
			npcRoot = npc:FindFirstChildWhichIsA("BasePart", true)
		end
	
		local character = player.Character
		local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
	
		if playerRoot and npcRoot then
			playerRoot.CFrame = npcRoot.CFrame * CFrame.new(0, 0, 3)
		end
	end)
	
end
coroutine.wrap(GJHXG_fake_script)()

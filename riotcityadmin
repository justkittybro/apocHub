local function THZUWHM_fake_script() -- PlayerButton_9.LocalScript 
	local script = Instance.new('LocalScript', PlayerButton_9)

	
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	
	local player = Players.LocalPlayer
	local button = script.Parent
	
	local enabled = false
	
	button.Text = "Infinite Jump: OFF"
	
	button.Activated:Connect(function()
		enabled = not enabled
	
		if enabled then
			button.Text = "Infinite Jump: ON"
		else
			button.Text = "Infinite Jump: OFF"
		end
	end)
	
	UserInputService.JumpRequest:Connect(function()
		if not enabled then return end
	
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	
		if humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end)
	
end
coroutine.wrap(THZUWHM_fake_script)()

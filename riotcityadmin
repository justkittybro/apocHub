local function OJVRC_fake_script() -- PlayerList.LocalScript 
	local script = Instance.new('LocalScript', PlayerList)

	
	local Players = game:GetService("Players")
	local LocalPlayer = Players.LocalPlayer
	
	local PlayerList = script.Parent
	local PlayerButton = PlayerList:WaitForChild("PlayerButton")
	
	PlayerButton.Visible = false
	
	local function RefreshPlayers()
		-- Remove old player buttons
		for _, child in ipairs(PlayerList:GetChildren()) do
			if child:IsA("TextButton") and child ~= PlayerButton then
				child:Destroy()
			end
		end
	
		-- Add all players
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				local Button = PlayerButton:Clone()
	
				Button.Name = player.Name
				Button.Visible = true
				Button.Parent = PlayerList
	
				local teamName = "No Team"
	
				if player.Team then
					teamName = player.Team.Name
				end
	
				Button.Text = player.Name .. " (" .. teamName .. ")"
	
				Button.MouseButton1Click:Connect(function()
					local targetCharacter = player.Character
					local myCharacter = LocalPlayer.Character
	
					if targetCharacter and myCharacter then
						local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
						local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
	
						if targetRoot and myRoot then
							myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
						end
					end
				end)
			end
		end
	end
	
	-- Update when players join or leave
	Players.PlayerAdded:Connect(RefreshPlayers)
	Players.PlayerRemoving:Connect(RefreshPlayers)
	
	-- Update when a player changes teams
	local function ConnectTeamChange(player)
		player:GetPropertyChangedSignal("Team"):Connect(RefreshPlayers)
		player:GetPropertyChangedSignal("TeamColor"):Connect(RefreshPlayers)
	end
	
	for _, player in ipairs(Players:GetPlayers()) do
		ConnectTeamChange(player)
	end
	
	Players.PlayerAdded:Connect(ConnectTeamChange)
	
	RefreshPlayers()
	
end

local function AHPA_fake_script() -- PlayerButton_12.LocalScript 
	local script = Instance.new('LocalScript', PlayerButton_12)

	-- LocalScript inside a TextButton
	local Players = game:GetService("Players")
	local UserInputService = game:GetService("UserInputService")
	local RunService = game:GetService("RunService")
	
	local LocalPlayer = Players.LocalPlayer
	local button = script.Parent
	
	-- Choose which feature this TextButton toggles:
	-- "ESP" | "InfJump" | "Fly" | "NoClip" | "AntiAFK"
	local MODE = "ESP"
	
	local enabled = false
	local connections = {}
	local bodyGyro, bodyVel
	
	local function clearConnections()
		for _, conn in ipairs(connections) do
			conn:Disconnect()
		end
		table.clear(connections)
	end
	
	local function applyESP(player)
		if player == LocalPlayer or not player.Character then return end
		if not player.Character:FindFirstChild("ESPHighlight") then
			local h = Instance.new("Highlight")
			h.Name = "ESPHighlight"
			h.Adornee = player.Character
			h.FillColor = Color3.fromRGB(255, 0, 0)
			h.OutlineColor = Color3.fromRGB(255, 0, 0)
			h.FillTransparency = 0.5
			h.OutlineTransparency = 0
			h.Parent = player.Character
		end
	end
	
	local function removeESP(player)
		if player.Character then
			local h = player.Character:FindFirstChild("ESPHighlight")
			if h then h:Destroy() end
		end
	end
	
	local function stopFly()
		if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
		if bodyVel then bodyVel:Destroy() bodyVel = nil end
	end
	
	local function setFeatureState(state)
		clearConnections()
		stopFly()
	
		if MODE == "ESP" then
			if state then
				for _, plr in ipairs(Players:GetPlayers()) do
					applyESP(plr)
					table.insert(connections, plr.CharacterAdded:Connect(function()
						task.wait(0.1)
						if enabled then applyESP(plr) end
					end))
				end
				table.insert(connections, Players.PlayerAdded:Connect(function(plr)
					table.insert(connections, plr.CharacterAdded:Connect(function()
						task.wait(0.1)
						if enabled then applyESP(plr) end
					end))
				end))
				table.insert(connections, Players.PlayerRemoving:Connect(removeESP))
			else
				for _, plr in ipairs(Players:GetPlayers()) do
					removeESP(plr)
				end
			end
	
		elseif MODE == "InfJump" then
			if state then
				table.insert(connections, UserInputService.JumpRequest:Connect(function()
					local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
					if hum then
						hum:ChangeState(Enum.HumanoidStateType.Jumping)
					end
				end))
			end
	
		elseif MODE == "Fly" then
			if state then
				local char = LocalPlayer.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if root then
					bodyGyro = Instance.new("BodyGyro")
					bodyGyro.P = 9e4
					bodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
					bodyGyro.cframe = root.CFrame
					bodyGyro.Parent = root
	
					bodyVel = Instance.new("BodyVelocity")
					bodyVel.velocity = Vector3.zero
					bodyVel.maxForce = Vector3.new(9e9, 9e9, 9e9)
					bodyVel.Parent = root
	
					table.insert(connections, RunService.RenderStepped:Connect(function()
						local cam = workspace.CurrentCamera
						if not (cam and root.Parent) then return end
						local dir = Vector3.zero
						if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += cam.CFrame.LookVector end
						if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= cam.CFrame.LookVector end
						if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= cam.CFrame.RightVector end
						if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += cam.CFrame.RightVector end
						bodyGyro.CFrame = cam.CFrame
						bodyVel.Velocity = dir.Magnitude > 0 and (dir.Unit * 50) or Vector3.zero
					end))
				end
			end
	
		elseif MODE == "NoClip" then
			local char = LocalPlayer.Character
			if state and char then
				table.insert(connections, RunService.Stepped:Connect(function()
					for _, part in ipairs(char:GetDescendants()) do
						if part:IsA("BasePart") then
							part.CanCollide = false
						end
					end
				end))
			elseif char then
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = true
					end
				end
			end
	
		elseif MODE == "AntiAFK" then
			if state then
				table.insert(connections, LocalPlayer.Idled:Connect(function()
					local VirtualUser = game:GetService("VirtualUser")
					VirtualUser:Button2Down(Vector2.zero, workspace.CurrentCamera)
					task.wait(1)
					VirtualUser:Button2Up(Vector2.zero, workspace.CurrentCamera)
				end))
			end
		end
	end
	
	button.Text = MODE .. ": OFF"
	
	button.MouseButton1Click:Connect(function()
		enabled = not enabled
		button.Text = MODE .. (enabled and ": ON" or ": OFF")
		button.BackgroundColor3 = enabled and Color3.fromRGB(40, 140, 80) or Color3.fromRGB(40, 40, 40)
		setFeatureState(enabled)
	end)
	
	LocalPlayer.CharacterAdded:Connect(function()
		if enabled and (MODE == "Fly" or MODE == "NoClip") then
			enabled = false
			button.Text = MODE .. ": OFF"
			button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
			setFeatureState(false)
		end
	end)
end

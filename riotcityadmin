local function RJNCXXJ_fake_script() -- PlayerMenu.LocalScript 
	local script = Instance.new('LocalScript', PlayerMenu)

	
	local Players = game:GetService("Players")
	
	local LocalPlayer = Players.LocalPlayer
	local PlayerMenu = script.Parent
	
	-- Your existing GUI objects
	local PlayerList = PlayerMenu:WaitForChild("PlayerList")
	local InfoFrame = PlayerMenu:WaitForChild("InfoFrame")
	
	local PlayerButtonTemplate = PlayerList:WaitForChild("PlayerButton")
	
	local Avatar = InfoFrame:WaitForChild("Avatar")
	local Username = InfoFrame:WaitForChild("Username")
	local DisplayName = InfoFrame:WaitForChild("DisplayName")
	local TeamLabel = InfoFrame:WaitForChild("Team")
	
	local TeleportButton = InfoFrame:WaitForChild("TeleportButton")
	local ViewButton = InfoFrame:WaitForChild("ViewButton")
	
	local selectedPlayer
	local viewingPlayer = false
	
	InfoFrame.Visible = false
	PlayerButtonTemplate.Visible = false
	
	-- Team colors
	local TEAM_COLORS = {
		Prisoner = Color3.fromRGB(229, 138, 50),
		Police = Color3.fromRGB(52, 127, 229),
		Fugitive = Color3.fromRGB(217, 68, 68)
	}
	
	-- Get player team
	local function getTeamName(player)
		if player.Team then
			return player.Team.Name
		end
	
		return "No Team"
	end
	
	-- Find player by username or display name
	local function findPlayer(name)
		name = string.lower(name)
	
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				if string.lower(player.Name) == name
					or string.lower(player.DisplayName) == name then
					return player
				end
			end
		end
	
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				if string.lower(player.Name):sub(1, #name) == name
					or string.lower(player.DisplayName):sub(1, #name) == name then
					return player
				end
			end
		end
	end
	
	-- Update InfoFrame
	local function updateInfoFrame(player)
		selectedPlayer = player
		InfoFrame.Visible = true
	
		Username.Text = "@" .. player.Name
		DisplayName.Text = player.DisplayName
	
		local teamName = getTeamName(player)
		TeamLabel.Text = teamName
	
		TeamLabel.TextColor3 =
			TEAM_COLORS[teamName]
			or Color3.fromRGB(255, 255, 255)
	
		local success, image = pcall(function()
			return Players:GetUserThumbnailAsync(
				player.UserId,
				Enum.ThumbnailType.HeadShot,
				Enum.ThumbnailSize.Size150x150
			)
		end)
	
		if success then
			Avatar.Image = image
		end
	end
	
	-- Create player buttons using your template
	local function createPlayerButton(player)
		if player == LocalPlayer then
			return
		end
	
		local button = PlayerButtonTemplate:Clone()
		button.Name = player.Name
		button.Visible = true
		button.Parent = PlayerList
	
		if button:IsA("TextButton") then
			button.Text = player.DisplayName .. " (@" .. player.Name .. ")"
		end
	
		local teamName = getTeamName(player)
	
		button.BackgroundColor3 =
			TEAM_COLORS[teamName]
			or Color3.fromRGB(60, 60, 60)
	
		button.Activated:Connect(function()
			updateInfoFrame(player)
		end)
	
		player:GetPropertyChangedSignal("Team"):Connect(function()
			if button and button.Parent then
				local newTeam = getTeamName(player)
	
				button.BackgroundColor3 =
					TEAM_COLORS[newTeam]
					or Color3.fromRGB(60, 60, 60)
			end
		end)
	end
	
	-- Refresh player list
	local function refreshPlayers()
		for _, object in ipairs(PlayerList:GetChildren()) do
			if object:IsA("TextButton")
				and object ~= PlayerButtonTemplate then
				object:Destroy()
			end
		end
	
		for _, player in ipairs(Players:GetPlayers()) do
			createPlayerButton(player)
		end
	end
	
	-- Teleport button
	TeleportButton.Activated:Connect(function()
		if not selectedPlayer then
			return
		end
	
		local targetCharacter = selectedPlayer.Character
		local myCharacter = LocalPlayer.Character
	
		if not targetCharacter or not myCharacter then
			return
		end
	
		local targetRoot =
			targetCharacter:FindFirstChild("HumanoidRootPart")
	
		local myRoot =
			myCharacter:FindFirstChild("HumanoidRootPart")
	
		if targetRoot and myRoot then
			myRoot.CFrame =
				targetRoot.CFrame * CFrame.new(0, 0, 3)
		end
	end)
	
	-- View button
	ViewButton.Activated:Connect(function()
		local camera = workspace.CurrentCamera
	
		if not camera then
			return
		end
	
		if viewingPlayer then
			viewingPlayer = false
	
			local myCharacter = LocalPlayer.Character
			local myHumanoid = myCharacter
				and myCharacter:FindFirstChildOfClass("Humanoid")
	
			if myHumanoid then
				camera.CameraSubject = myHumanoid
			end
	
			ViewButton.Text = "View"
			return
		end
	
		if not selectedPlayer then
			return
		end
	
		local targetCharacter = selectedPlayer.Character
		local targetHumanoid = targetCharacter
			and targetCharacter:FindFirstChildOfClass("Humanoid")
	
		if targetHumanoid then
			viewingPlayer = true
			camera.CameraSubject = targetHumanoid
			ViewButton.Text = "Unview"
		end
	end)
	
	-- Reset camera when respawning
	LocalPlayer.CharacterAdded:Connect(function(character)
		local humanoid = character:WaitForChild("Humanoid")
	
		viewingPlayer = false
		workspace.CurrentCamera.CameraSubject = humanoid
		ViewButton.Text = "View"
	end)
	
	-- Player joins/leaves
	Players.PlayerAdded:Connect(function()
		task.wait(0.5)
		refreshPlayers()
	end)
	
	Players.PlayerRemoving:Connect(function(player)
		if selectedPlayer == player then
			selectedPlayer = nil
			InfoFrame.Visible = false
		end
	
		refreshPlayers()
	end)
	
	-- Initial list
	refreshPlayers()
	
end
coroutine.wrap(RJNCXXJ_fake_script)()

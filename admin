local function UNCBV_fake_script() -- PlayerButton_3.LocalScript 
	local script = Instance.new('LocalScript', PlayerButton_3)

	
	local Players = game:GetService("Players")
	
	local player = Players.LocalPlayer
	local button = script.Parent
	
	button.Activated:Connect(function()
		local city = workspace:FindFirstChild("City")
		if not city then return end
	
		local store = city:FindFirstChild("Store")
		if not store then return end
	
		local npc = store:FindFirstChild("NPC")
		if not npc then return end
	
		local npcRoot = npc:FindFirstChild("HumanoidRootPart")
			or npc.PrimaryPart
	
		if not npcRoot then
			npcRoot = npc:FindFirstChildWhichIsA("BasePart", true)
		end
	
		local character = player.Character
		local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
	
		if playerRoot and npcRoot then
			playerRoot.CFrame = npcRoot.CFrame * CFrame.new(0, 0, 3)
		end
	end)
	
end
coroutine.wrap(UNCBV_fake_script)()
local function WXMYVJ_fake_script() -- Frame.LocalScript 
	local script = Instance.new('LocalScript', Frame)

	
	local Players = game:GetService("Players")
	
	local player = Players.LocalPlayer
	local playerList = script.Parent:WaitForChild("PlayerList")
	local template = playerList:WaitForChild("PlayerButton")
	
	template.Visible = false
	
	local function refresh()
		for _, child in ipairs(playerList:GetChildren()) do
			if child:IsA("TextButton") and child ~= template then
				child:Destroy()
			end
		end
	
		for _, target in ipairs(Players:GetPlayers()) do
			if target ~= player then
				local button = template:Clone()
				button.Name = target.Name .. "Button"
				button.Text = target.DisplayName .. " (@" .. target.Name .. ")"
				button.Visible = true
				button.Parent = playerList
	
				button.Activated:Connect(function()
					local character = player.Character
					local targetCharacter = target.Character
	
					if character and targetCharacter then
						local myRoot = character:FindFirstChild("HumanoidRootPart")
						local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
	
						if myRoot and targetRoot then
							myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
						end
					end
				end)
			end
		end
	end
	
	Players.PlayerAdded:Connect(refresh)
	Players.PlayerRemoving:Connect(refresh)
	
	refresh()
	
end
coroutine.wrap(WXMYVJ_fake_script)()
